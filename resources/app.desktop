[Desktop Entry]
Name=Compact Launcher
Comment=A compact application launcher for the COSMIC Desktop
Type=Application
Icon=io.github.gilson_fonsaca.cosmic_compact_launcher
Exec=compact_launcher %F
Terminal=false
StartupNotify=true
Categories=Utility;
Keywords=COSMIC;launcher;panel;applet;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
