  <url type="bugtracker">https://github.com/gilson-fonsaca/cosmic_compact_launcher/issues</url>
  <launchable type="desktop-id">io.github.gilson_fonsaca.cosmic_compact_launcher.desktop</launchable>
  <provides>
    <id>io.github.gilson_fonsaca.cosmic_compact_launcher</id>
